# Server Configuration
PORT=5000

# Gemini AI Configuration (get a key at https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-side Firebase access for the public statistics page (aggregates only).
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Locally: point to the downloaded file. On Vercel: paste the JSON on one line into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT=

# Cloudinary Storage Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# API Base URL (leave empty for relative /api proxied through Vite)
VITE_API_BASE_URL=
